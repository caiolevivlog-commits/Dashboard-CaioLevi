rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Connection test document
    match /test/connection {
      allow read: if true;
    }

    // Sales transactions collection
    match /sales/{saleId} {
      allow read: if true;
      allow create: if request.resource.data.data is string
                    && request.resource.data.vendedor is string
                    && request.resource.data.produto is string
                    && request.resource.data.quantidade is number
                    && request.resource.data.preco is number
                    && request.resource.data.faturamento is number
                    && request.resource.data.formaPagamento is string;
      allow update: if request.resource.data.data is string
                    && request.resource.data.vendedor is string
                    && request.resource.data.produto is string
                    && request.resource.data.quantidade is number
                    && request.resource.data.preco is number
                    && request.resource.data.faturamento is number;
      allow delete: if true;
    }

    // Default safety catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
